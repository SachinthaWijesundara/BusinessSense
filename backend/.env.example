# Backend settings. For local runs copy to backend/.env (or use the repo-root .env).
# On Render set these in the service's Environment tab instead. Never commit real values.

# --- OpenAI (server-side only; the browser never calls OpenAI) ---
OPENAI_API_KEY=
INVOICE_VISION_MODEL=gpt-4o
SKU_MATCH_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Keep invoice images and values out of OpenAI traces (true only while debugging).
AGENTS_TRACE_SENSITIVE_DATA=false

# --- Supabase ---
# Postgres connection string (Supabase > Connect > "Transaction pooler", port 6543).
# Empty = in-memory store for quick local tries (nothing is saved).
DATABASE_URL=
# Set to true on Render so the API refuses to start without a database.
REQUIRE_DATABASE=false
# Storage for invoice photos (private bucket, signed URLs). Service-role / secret key, server only.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_INVOICE_BUCKET=invoice-images

# --- HTTP ---
# Comma-separated frontend origins allowed by CORS (your Vercel URL in production).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional regex for Vercel preview deployments, e.g. https://businesssense-.*\.vercel\.app
ALLOWED_ORIGIN_REGEX=
MAX_UPLOAD_MB=10

# --- Business rules (proposal defaults) ---
SKU_MATCH_THRESHOLD=0.82
MATH_AUDIT_TOLERANCE=1.0
