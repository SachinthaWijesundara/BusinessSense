# Backend settings. For local runs copy this file to backend/.env and fill it in.
# On Render, set the same names in the service's Environment tab. Never commit real values.

# --- OpenAI (server-side only; the browser never talks to OpenAI) ---
OPENAI_API_KEY=
# The proposal uses gpt-4o. The team's current OpenAI key only allows gpt-4o-mini (and blocks
# text-embedding-3-small): set INVOICE_VISION_MODEL=gpt-4o-mini until the project allows more.
INVOICE_VISION_MODEL=gpt-4o
SKU_MATCH_MODEL=gpt-4o-mini
EMBEDDING_MODEL=text-embedding-3-small
# Keep invoice images and values out of OpenAI traces (true only while debugging).
AGENTS_TRACE_SENSITIVE_DATA=false

# --- Supabase ---
# Required. Postgres connection string: Supabase > Connect > "Transaction pooler" (port 6543).
DATABASE_URL=
# Optional. Private Storage for invoice photos (service-role / secret key, server only).
# Without these, invoices are saved without their photo.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_INVOICE_BUCKET=invoice-images

# --- HTTP ---
# Comma-separated websites allowed to call the API (your Vercel address in production).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
# Optional pattern for Vercel preview deployments, e.g. https://businesssense-.*\.vercel\.app
ALLOWED_ORIGIN_REGEX=
MAX_UPLOAD_MB=10

# --- Business rules (proposal defaults) ---
SKU_MATCH_THRESHOLD=0.82
MATH_AUDIT_TOLERANCE=1.0
