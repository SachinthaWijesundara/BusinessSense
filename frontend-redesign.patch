+  padding: 3rem;
+  background: linear-gradient(160deg, var(--brand-deep), #0e2c22 70%);
+  color: #e8f2ec;
+}
+
+@media (min-width: 900px) {
+  .bs-login-aside {
+    display: flex;
+    flex-direction: column;
+    justify-content: space-between;
+  }
+}
+
+.bs-login-points li {
+  display: flex;
+  gap: 0.75rem;
+  margin-top: 1.1rem;
+  color: #cfe3d8;
+}
+
+.bs-login-points li > span:first-child {
+  display: inline-flex;
+  align-items: center;
+  justify-content: center;
+  width: 1.7rem;
+  height: 1.7rem;
+  flex-shrink: 0;
+  border-radius: 999px;
+  background: rgb(255 255 255 / 12%);
+  color: #fff;
+  font-size: 0.85rem;
+}
+
+.bs-login-main {
+  display: flex;
+  align-items: center;
+  justify-content: center;
+  padding: 2rem 1.25rem;
 }
 
