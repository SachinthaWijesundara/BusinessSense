# BusinessSense: files Git must never upload.

# Secrets: each app keeps its real keys in its own .env (see frontend/.env.example, backend/.env.example)
.env
.env.local
.env.*.local

# Frontend: downloaded libraries and build output
frontend/node_modules/
frontend/.next/
frontend/tsconfig.tsbuildinfo

# Backend: virtual environment, Python caches, test caches, the test database's libraries
backend/.venv/
__pycache__/
*.pyc
backend/.pytest_cache/
backend/tests/pglite/node_modules/
# Trained models and their reports are built from a shop's private invoices: never commit them
backend/ml/output/

# Editor and operating-system files
.DS_Store
.cursor/
*.log
