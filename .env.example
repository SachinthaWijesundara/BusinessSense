# Copy to BusinessSense/.env for local development (both apps read it). Never commit the real file.
# Production: backend variables go in Render, frontend variables in Vercel.

# --- Backend (FastAPI) - full list with comments in backend/.env.example ---
OPENAI_API_KEY=
INVOICE_VISION_MODEL=gpt-4o
SKU_MATCH_MODEL=gpt-4o-mini
DATABASE_URL=
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Frontend (Next.js) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_ANON_KEY
NEXT_PUBLIC_EXTRACT_API_URL=http://localhost:8765
